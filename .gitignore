# --- Secrets and local config (never commit) ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments ---
venv*/
.venv/
env/

# --- Tests and tooling caches ---
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# --- App data generated at runtime ---
# cached search results (large, machine-specific)
data/serpapi_cache.json
# user-uploaded label photos
static/uploads/
# local OCR test photos
test_images/

# --- Trained or exported model files (the app builds its embeddings at startup) ---
models/
*.pkl

# --- Editors and OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log